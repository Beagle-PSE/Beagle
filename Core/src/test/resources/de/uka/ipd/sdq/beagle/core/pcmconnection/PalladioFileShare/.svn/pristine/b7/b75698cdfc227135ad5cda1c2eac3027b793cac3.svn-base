public interface IHash {

	/**
	 * @param inputBytes
	 * @return
	 */
	public abstract byte[] getMessageDigest(byte[] inputBytes);

	/**TODO
	 * @return the (final static) message digest type represented by this object
	 */
	public abstract String getMessageDigestType();

}