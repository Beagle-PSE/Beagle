      <ownedOperation xmi:type="uml:Operation" xmi:id="_zcUEIKDUEeWv3dQk34uqzw" name="main" method="_vu0-kKD8EeWVpfCzK8hwSg">
        <ownedComment xmi:type="uml:Comment" xmi:id="_i3kqAKDVEeWv3dQk34uqzw" annotatedElement="_zcUEIKDUEeWv3dQk34uqzw _I-iE4KDUEeWv3dQk34uqzw">
          <body>prepare input artefacts()&#xD;
 &#xD;
finished ≔ false&#xD;
readOnlyBlackboardView ≔ {@link #_DQjdUKDzEeWVpfCzK8hwSg}.{@link #__BK2UKDzEeWVpfCzK8hwSg}({@link #_WdHJ4KDUEeWv3dQk34uqzw})&#xD;
measurementControllerBlackboardView ≔ {@link #_gzE1gKiSEeW317sgBX4gxw}.{@link #_pnMmcKimEeW317sgBX4gxw}({@link #_WdHJ4KDUEeWv3dQk34uqzw})&#xD;
analyserBlackboardView ≔ {@link Analysis.uml#_rqzFQKD4EeWVpfCzK8hwSg}.{@link Analysis.uml#_zR0rkKD5EeWVpfCzK8hwSg}({@link Analysis.uml#_5qdooKD5EeWVpfCzK8hwSg})&#xD;
finalJudgeBlackboardView ≔ {@link ../Beagle.uml#_gYTZELLaEeWi36SSdQyzSA}.{@link ../Beagle.uml#_yN9MALLaEeWi36SSdQyzSA}({@link ../Beagle.uml#_yN9MALLaEeWi36SSdQyzSA})&#xD;
 &#xD;
while (¬finished) do&#xD;
  if {@link #_qgn4gqD1EeWVpfCzK8hwSg}.{@link #_664BkLClEeWUDtVlk6a50w}(readOnlyBlackboardView) then&#xD;
    {@link #_qgn4gqD1EeWVpfCzK8hwSg}.{@link #_Tc6FQKD1EeWVpfCzK8hwSg}(measurementControllerBlackboardView)&#xD;
  else&#xD;
    analysersIterator ≔ {@link #_F6a7MqD2EeWVpfCzK8hwSg}.iterator()&#xD;
    while ¬analysersIterator.current().{@link Analysis.uml#_N6x2QKDxEeWVpfCzK8hwSg}(readOnlyBlackboardView) do&#xD;
      analysersIterator.next()&#xD;
    od&#xD;
    if analysersIterator.current().{@link Analysis.uml#_N6x2QKDxEeWVpfCzK8hwSg}(readOnlyBlackboardView)&#xD;
      analysersIterator.current().{@link Analysis.uml#_6buAEKDxEeWVpfCzK8hwSg}(analyserBlackboardView)&#xD;
    else&#xD;
      finished ≔{@link #_808_4LLaEeWi36SSdQyzSA}.{@link ../Beagle.uml#_yN9MALLaEeWi36SSdQyzSA}(finalJudgeBlackboardView)&#xD;
    fi&#xD;
  fi&#xD;
od&#xD;
 &#xD;
write results()</body>
        </ownedComment>
